# Required connection settings. Do not commit the real token.
ZB202_INFLUX_URL=http://influxdb.itf.beeerise.com
ZB202_INFLUX_TOKEN=replace-with-the-token-from-your-administrator
ZB202_INFLUX_ORG=PolyU
ZB202_INFLUX_BUCKET=zb202_iot

# Optional schema and polling settings.
ZB202_INFLUX_MEASUREMENT=
ZB202_INFLUX_DEVICE_COLUMN=devEui
ZB202_INFLUX_POLL_INTERVAL_MS=10000
ZB202_INFLUX_QUERY_TIMEOUT_MS=30000
ZB202_INFLUX_POLL_LOOKBACK=-15m
ZB202_INFLUX_HISTORY_RANGE=-24h
ZB202_INFLUX_BRIDGE_PORT=8787
# Public deployments: refuse socket control, meeting edits and mode changes.
ZB202_BRIDGE_READ_ONLY=false
# Or allow them only with this access key (the page asks for it once per browser session).
ZB202_BRIDGE_WRITE_KEY=
# Refuse control commands while ZB202_BRIDGE_WRITE_KEY is unset (recommended for public bridges).
ZB202_BRIDGE_REQUIRE_KEY=false
# Comma-separated extra browser origins, e.g. https://zb202-digital-twin.vercel.app
ZB202_BRIDGE_ALLOWED_ORIGINS=

# Optional weather station source. Uses the same URL and organization.
# Leave blank when weather measurements are stored in ZB202_INFLUX_BUCKET.
ZB202_WEATHER_INFLUX_BUCKET=
ZB202_WEATHER_INFLUX_MEASUREMENT=
# Set when the weather bucket needs a separate token; otherwise uses ZB202_INFLUX_TOKEN.
ZB202_WEATHER_INFLUX_TOKEN=

# MQTT downlink settings for WS523 socket control.
ZB202_MQTT_URL=mqtt://itf.beeerise.com:1889
ZB202_MQTT_USERNAME=replace-with-the-mqtt-username
ZB202_MQTT_PASSWORD=replace-with-the-mqtt-password
ZB202_MQTT_DOWNLINK_DELAY_MS=10000

# HKO King's Park solar radiation: defaults to the weather bucket, then IoT bucket.
# Requires write access as well as read access using the weather token.
ZB202_SOLAR_INFLUX_BUCKET=

# AI outdoor-air strategy. Mode L0 = recommend only, L1 = shadow mode (default). L2 needs FMO authorisation.
ZB202_STRATEGY_ENABLED=true
ZB202_STRATEGY_MODE=L1
# bisection (v1, default) or dp (v2 dynamic programming over damper steps).
ZB202_STRATEGY_OPTIMIZER=bisection
# Chiller plant COP for savings estimates (default 4.5).
ZB202_STRATEGY_PLANT_COP=
# Write each recommendation to InfluxDB (needs a token with write access).
ZB202_STRATEGY_INFLUX_WRITE=false
ZB202_STRATEGY_INFLUX_BUCKET=
